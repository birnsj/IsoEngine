{
  "Id": "guard_dialog",
  "Name": "Village Guard Conversation",
  "StartNodeId": "greeting",
  "Nodes": {
    "greeting": {
      "Id": "greeting",
      "Text": "Greetings, traveler! Welcome to our village. How may I assist you?",
      "Choices": [
        {
          "Text": "Tell me about this village.",
          "NextNodeId": "village_info",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        },
        {
          "Text": "Have you seen anything suspicious?",
          "NextNodeId": "suspicious",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        },
        {
          "Text": "I\u0027m just passing through.",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        }
      ]
    },
    "village_info": {
      "Id": "village_info",
      "Text": "This is a peaceful farming village. We\u0027ve been here for generations, growing crops and raising livestock. The villagers are friendly, and we rarely have trouble.",
      "Choices": [
        {
          "Text": "What about the surrounding area?",
          "NextNodeId": "surrounding_area",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        },
        {
          "Text": "Thank you for the information.",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        }
      ]
    },
    "surrounding_area": {
      "Id": "surrounding_area",
      "Text": "The forest to the north can be dangerous at night. We\u0027ve heard strange noises coming from there. During the day, it\u0027s safe enough, but I\u0027d recommend staying on the main paths.",
      "Choices": [
        {
          "Text": "What kind of strange noises?",
          "NextNodeId": "strange_noises",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": "AskedAboutNoises",
          "SetFlagValue": true
        },
        {
          "Text": "I\u0027ll be careful. Thanks!",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        }
      ]
    },
    "strange_noises": {
      "Id": "strange_noises",
      "Text": "Howling, mostly. Some of the villagers say they\u0027ve seen glowing eyes in the darkness. I haven\u0027t seen it myself, but I trust their word. Best to stay away after sunset.",
      "Choices": [
        {
          "Text": "That\u0027s concerning. I\u0027ll keep my guard up.",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        },
        {
          "Text": "Maybe I should investigate...",
          "NextNodeId": "investigation_warning",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        }
      ]
    },
    "investigation_warning": {
      "Id": "investigation_warning",
      "Text": "I wouldn\u0027t recommend that, traveler. We\u0027ve lost a few people who went into the forest at night. If you must go, at least wait until morning and bring a weapon.",
      "Choices": [
        {
          "Text": "I understand. I\u0027ll be cautious.",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        },
        {
          "Text": "I can handle myself.",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        }
      ]
    },
    "suspicious": {
      "Id": "suspicious",
      "Text": "Hmm, now that you mention it... There was a stranger who came through yesterday. Didn\u0027t say much, just asked about the old ruins to the east. Seemed in a hurry.",
      "Choices": [
        {
          "Text": "What did they look like?",
          "NextNodeId": "stranger_description",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": "AskedAboutStranger",
          "SetFlagValue": true
        },
        {
          "Text": "Old ruins? Tell me more.",
          "NextNodeId": "ruins_info",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        },
        {
          "Text": "I see. Thanks for the information.",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        }
      ]
    },
    "stranger_description": {
      "Id": "stranger_description",
      "Text": "Tall, wearing a dark cloak. Had a scar across their left cheek. Carried themselves like someone who\u0027s seen combat. They left heading east toward the ruins.",
      "Choices": [
        {
          "Text": "Tell me about the ruins.",
          "NextNodeId": "ruins_info",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        },
        {
          "Text": "I\u0027ll keep an eye out. Thanks!",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        }
      ]
    },
    "ruins_info": {
      "Id": "ruins_info",
      "Text": "The ruins are ancient, predating our village by centuries. No one goes there much - it\u0027s said to be cursed. The stranger seemed very interested in them, though.",
      "Choices": [
        {
          "Text": "Cursed? What do you mean?",
          "NextNodeId": "curse_info",
          "RequiredFlag": "AskedAboutStranger",
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        },
        {
          "Text": "Interesting. I might check them out.",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        },
        {
          "Text": "Thanks for the warning.",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        }
      ]
    },
    "curse_info": {
      "Id": "curse_info",
      "Text": "Old stories say that anyone who disturbs the ruins will bring misfortune upon themselves. I don\u0027t know if it\u0027s true, but I\u0027ve never heard of anyone who went there and came back unchanged.",
      "Choices": [
        {
          "Text": "That\u0027s quite a story. I\u0027ll be careful.",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        },
        {
          "Text": "Sounds like superstition to me.",
          "NextNodeId": "farewell",
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        }
      ]
    },
    "farewell": {
      "Id": "farewell",
      "Text": "Safe travels, traveler! If you need anything else, just ask.",
      "Choices": [
        {
          "Text": "Goodbye!",
          "NextNodeId": null,
          "RequiredFlag": null,
          "RequiredValue": true,
          "SetFlag": null,
          "SetFlagValue": true
        }
      ]
    }
  }
}